		"@biomejs/biome": "^2.4.16",
		"lefthook": "^2.1.9",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"wrangler": "^4.95.0"
	}
}
