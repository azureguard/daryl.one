		"@iconify-json/simple-icons": "^1.2.84",
		"@iconify/utils": "^2.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"astro": "^6.4.2",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"tailwindcss": "^4.3.0",
