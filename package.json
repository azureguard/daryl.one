{
	"name": "daryl-one",
	"type": "module",
	"version": "0.0.1",
	"author": "Daryl Wong",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/azureguard/daryl.one.git"
	},
	"bugs": "https://github.com/azureguard/daryl.one/issues",
	"homepage": "https://daryl.one",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24"
		}
	},
	"scripts": {
		"predev": "node scripts/generate-cv-types.js",
		"dev": "astro dev --host",
		"prestart": "node scripts/generate-cv-types.js",
		"start": "astro dev",
		"generate:cv-types": "node scripts/generate-cv-types.js",
		"prebuild": "node scripts/generate-cv-types.js && astro check",
		"build": "astro build",
		"preview": "astro preview",
		"prepreview": "astro build",
		"preview:cf": "wrangler dev --config dist/server/wrangler.json",
		"astro": "astro",
		"format": "biome check --staged",
		"format:fix": "biome check --staged --write",
		"postinstall": "lefthook install && node scripts/generate-cv-types.js"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^14.1.2",
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@iconify-json/charm": "^1.2.3",
		"@iconify-json/codicon": "^1.2.63",
		"@iconify-json/lucide": "^1.2.117",
		"@iconify-json/simple-icons": "^1.2.90",
		"@iconify/utils": "^2.3.0",
		"@jsonresume/schema": "^1.3.0",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "7.0.7",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"tailwindcss": "^4.3.2",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"json-schema-to-typescript": "^15.0.4",
		"lefthook": "^2.1.10",
		"wrangler": "^4.110.0"
	}
}
