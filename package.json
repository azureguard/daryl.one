	"homepage": "https://daryl.one",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^11"
		}
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"prebuild": "astro check",
		"build": "astro build",
		"preview": "astro preview",
		"prepreview:cf": "astro build",
		"preview:cf": "wrangler pages dev ./dist",
		"astro": "astro",
		"format": "biome format & prettier --check .",
		"format:fix": "biome format --write & prettier --write .",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"postinstall": "lefthook install"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^13.6.0",
		"@astrojs/sitemap": "^3.7.3",
