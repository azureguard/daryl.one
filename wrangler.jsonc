{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cv",
	"compatibility_date": "2026-07-14",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": true,
	"routes": [{ "pattern": "daryl.one", "custom_domain": true }],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
		},
	},
}
