---
import { ClientRouter, fade } from "astro:transitions";
import { basics } from "@cv";
import { SEO } from "astro-seo";
import { Schema } from "astro-seo-schema";
import type { Thing, WithContext } from "schema-dts";
import { getPublished } from "@/lib/content";
import { ogImageFor } from "@/lib/og";
import { pagePath } from "@/lib/url";
import "../styles/global.css";

interface Props {
	title: string;
	/** The page's own summary (a post's or case study's frontmatter). Defaults to the CV summary. */
	description?: string | undefined;
	/** Marks the page as an Open Graph article (posts, case studies). */
	article?: { published: Date; modified?: Date | undefined; tags?: Array<string> | undefined } | undefined;
	/** schema.org JSON-LD for the page (src/lib/structured-data.ts). */
	schema?: WithContext<Thing> | undefined;
}

const { title, article, schema } = Astro.props;
const path = pagePath(Astro.url);
const url = new URL(path, Astro.site);

// Search engines truncate descriptions around 155-160 characters, so a page
// without its own uses the summary's first sentence, and either is clamped at a
// word boundary as a safety net.
const { summary = "" } = basics;
const source = Astro.props.description ?? summary.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? summary;
const description = source.length <= 160 ? source : `${source.slice(0, 157).replace(/\s+\S*$/, "")}…`;

// Open Graph article tags for posts and case studies. Keys are only set when
// there is a value (astro-seo's types reject explicit undefined here).
const openGraphArticle = article && {
	publishedTime: article.published.toISOString(),
	authors: [basics.name],
	...(article.modified && { modifiedTime: article.modified.toISOString() }),
	...(article.tags && { tags: article.tags }),
};

// The page's preview image from /og/[...route].ts: a post's or case study's
// own, otherwise the shared site card.
const image = await ogImageFor(path, Astro.site);

// The feed is advertised only while the blog exists (see SiteLayout).
const hasPosts = (await getPublished("blog")).length > 0;

// <ClientRouter /> lives in this shared <head> so every route is client-routed.
// The crossfade is pinned to `--duration-base` so page transitions read as part
// of the same motion scale as hovers. Astro disables it under reduced motion.
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: "var(--duration-base)" })}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<SEO
			title={title}
			description={description}
			canonical={url}
			openGraph={{
				basic: { title, type: article ? "article" : "website", image: image.href, url },
				optional: { description, siteName: basics.name, locale: "en_GB" },
				image: { width: 1200, height: 630, alt: title },
				...(openGraphArticle && { article: openGraphArticle }),
			}}
			twitter={{ card: "summary_large_image", title, description, image, imageAlt: title }}
			extend={{
				link: [
					{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
					...(hasPosts ? [{ rel: "alternate", type: "application/rss+xml", title: `${basics.name} - Blog`, href: "/rss.xml" }] : []),
				],
			}}
		/>
		{schema && <Schema item={schema} />}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#eef2ef" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#06110c" media="(prefers-color-scheme: dark)" />
		<ClientRouter />

		<script>
			// Applies the theme class before first paint, so there is no flash of
			// the wrong theme. ThemeSwitch.astro owns changes after load; both read
			// the same "theme" localStorage key.
			//
			// Astro's swap copies the NEW document's <html> attributes over the old
			// one, which drops the class this script added, and bundled scripts do
			// not re-run after a navigation. So the class is also applied to
			// `newDocument` in astro:before-swap, which fires before the swap and
			// before paint. The listener sits on `document`, which persists.
			type Theme = "light" | "dark" | "system";

			function resolveTheme(): "light" | "dark" {
				const stored = localStorage.getItem("theme") as Theme | null;
				const theme: Theme = stored === "dark" || stored === "light" ? stored : "system";
				if (theme !== "system") return theme;
				return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function applyTheme(target: Document) {
				target.documentElement.classList.remove("light", "dark");
				target.documentElement.classList.add(resolveTheme());
			}

			applyTheme(document);

			document.addEventListener("astro:before-swap", (event) => {
				applyTheme(event.newDocument);
			});
		</script>
	</head>
	<body>
		<slot />
		<script>
			// Firefox prints a running CSS animation at its current frame and
			// ignores the print sheet's `animation: none` for it, so printing
			// within a second of a page load put every mid-reveal element on paper
			// blank. Jumping each finite animation to its end state before the
			// print snapshot is what both engines honour. Looping ones (the
			// severity flash) have no end state, so they are rewound to their
			// first frame, at rest, and held there until printing is done.
			const held = new Set<Animation>();

			window.addEventListener("beforeprint", () => {
				for (const animation of document.getAnimations()) {
					if (animation.effect?.getComputedTiming().iterations === Number.POSITIVE_INFINITY) {
						animation.pause();
						animation.currentTime = 0;
						held.add(animation);
					} else {
						animation.finish();
					}
				}
			});

			window.addEventListener("afterprint", () => {
				for (const animation of held) animation.play();
				held.clear();
			});
		</script>
	</body>
</html>
