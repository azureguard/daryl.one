---
import { basics } from "@cv";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const url = canonicalUrl.href;

const { summary = "" } = basics;

// Search engines truncate descriptions around 155-160 characters, so use the
// summary's first sentence, clamped at a word boundary as a safety net.
const firstSentence = summary.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? summary;
const description = firstSentence.length <= 160 ? firstSentence : `${firstSentence.slice(0, 157).replace(/\s+\S*$/, "")}…`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:url" content={url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta property="twitter:domain" content={url.split("//")[1] ?? ""} />
		<meta property="twitter:url" content={url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="" />

		<link rel="canonical" href={url} />
	</head>
	<body class="relative bg-skin-fill text-skin-base antialiased">
		<slot />
		<style is:global>
			@reference "../styles/global.css";

			/*
			 * These are base/reset rules. They must live in `@layer base` so they
			 * stay below Tailwind's `@layer utilities`; otherwise (being unlayered)
			 * they would override utilities in v4 — e.g. `ul { list-style: none }`
			 * beating `list-disc`, or `a { text-decoration: none }` beating
			 * `hover:underline`.
			 */
			@layer base {
				body,
				figure {
					margin: 0;
					padding: 0;
				}

				body {
					font-family: var(--font-sans);
				}

				a {
					text-decoration: none;
				}

				ul {
					list-style: none;
					margin: 0;
					padding: 0;
				}

				*,
				*::before,
				*::after {
					box-sizing: border-box;
				}

				h1,
				h2,
				h3,
				h4 {
					@apply font-semibold tracking-tight text-skin-base;
					margin: 0;
				}

				p {
					@apply text-sm text-skin-muted;
					line-height: 1.5;
					text-wrap: pretty;
				}

			}

			/*
			 * Print overrides. These live OUTSIDE `@layer base` on purpose:
			 * unlayered CSS beats every layer, and these rules must win over
			 * both the unlayered theme tokens in global.css and Tailwind's
			 * utilities (e.g. `display: flex` on a <summary>). They are scoped
			 * to `@media print`, so screen rendering is untouched.
			 */
			@media print {
				/*
				 * Black-on-white: collapse the light AND dark palettes to plain
				 * ink. `html:root` / `:root.dark` out-specifies the `:root` /
				 * `.dark` token blocks in global.css.
				 */
				html:root,
				:root.dark {
					color-scheme: light;
					--color-fill: #fff;
					--color-text-base: #000;
					--color-text-muted: #3f463f;
					--color-text-inverted: #fff;
					--color-edge: #d0d0d0;
					--color-accent: #000;
					--color-button-accent: #000;
					--color-button-accent-hover: #000;
					--color-button-muted: #fff;
				}

				/*
				 * <details> must print expanded: closed ones hide their content
				 * via `content-visibility: hidden` on ::details-content, so
				 * force it visible and hide the show-more/show-less toggle.
				 * (A beforeprint fallback in Experience.astro covers browsers
				 * without ::details-content support.)
				 */
				details > summary {
					display: none;
				}

				details::details-content {
					content-visibility: visible;
					display: block;
				}

				/* Compact body copy on paper (the base `p` rule sets text-sm). */
				p {
					font-size: 0.75rem;
					line-height: 1.45;
				}

				/*
				 * Pagination: keep entries (bullets, education/skill items,
				 * cards) intact across page breaks. Long Experience roles
				 * (the <li>s containing a <details>) may flow across pages —
				 * gluing a 400px role block would leave big gaps — but
				 * headings never separate from their content.
				 */
				article,
				li {
					break-inside: avoid;
				}

				li:has(details) {
					break-inside: auto;
				}

				h1,
				h2,
				h3,
				h4,
				header {
					break-inside: avoid;
					break-after: avoid;
				}

				astro-dev-toolbar {
					display: none;
				}
			}
		</style>
	</body>
</html>
