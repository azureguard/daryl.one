---
import Footer from "@/components/Footer.astro";
import SiteNav from "@/components/SiteNav.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import { getPublished } from "@/lib/content";
import Layout from "./Layout.astro";

interface Props {
	title: string;
	/** Vertical rhythm between the page's top-level blocks. */
	gap?: "sm" | "md" | "lg" | undefined;
	/**
	 * A wider measure for compositions that need two columns (the landing
	 * page). Only <main> widens: the nav and footer keep the 760px measure on
	 * every page, so nothing shifts when navigating away from the landing page.
	 */
	wide?: boolean | undefined;
}

const { title, gap = "lg", wide = false } = Astro.props;

// Nav order follows the DS (CV, Projects, Blog, About, Uses). Gallery is parked
// in the DS as future scope, and Blog appears only once a post is published: an empty "Audit
// trail" is a dead end, so the route and every link to it wait for content.
const hasPosts = (await getPublished("blog")).length > 0;
const links = [
	{ label: "CV", href: "/cv" },
	{ label: "Projects", href: "/projects" },
	...(hasPosts ? [{ label: "Blog", href: "/blog" }] : []),
	{ label: "About", href: "/about" },
	{ label: "Uses", href: "/uses" },
];

// Skip link (WCAG 2.4.1): without it a keyboard user passes the wordmark,
// every nav link and the theme switch before reaching content, on every page
// and again after every client-side navigation. `tabindex="-1"` makes <main>
// focusable so the reader continues into it.
//
// The floating ThemeSwitch is the DS's dock: it fades in bottom-right once
// the nav scrolls away, with a back-to-top tile beside it.
//
// <main> owns the site measure so every page shares one column. Its print
// treatment is below, after the screen rule, in this same stylesheet.
---

<Layout title={title}>
	<a href="#main-content" class="skip label" data-print="hidden">Skip to main content</a>
	<SiteNav links={links} active={Astro.url.pathname} />
	<main id="main-content" tabindex="-1" data-gap={gap} data-wide={wide ? "" : undefined}>
		<slot />
	</main>
	<Footer />
	<ThemeSwitch floating watch="#site-nav" backToTop />
</Layout>

<style>
	.skip {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		z-index: 50;
		padding: var(--space-2) var(--space-3);
		background: var(--surface-card);
		box-shadow: inset 0 0 0 1px var(--border-raised);
		color: var(--text-body);
		text-decoration: none;
		transform: translateY(-200%);
	}

	.skip:focus {
		transform: none;
	}

	/* Short pages keep the footer at the bottom of the screen: <main> takes the
	   leftover height. */
	@media screen {
		:global(body) {
			display: flex;
			flex-direction: column;
		}

		main {
			flex: 1 0 auto;
			width: 100%;
		}
	}

	main {
		display: flex;
		flex-direction: column;
		max-width: 760px;
		margin-inline: auto;
		padding: var(--space-16) var(--space-6) var(--space-20);
	}

	/* A one-screen composition is centred in whatever height is left between
	   the nav and the footer. */
	main[data-wide] {
		max-width: 1200px;
		justify-content: center;
	}

	main:focus {
		outline: none;
	}

	main[data-gap="sm"] {
		gap: var(--space-8);
	}

	main[data-gap="md"] {
		gap: var(--space-12);
	}

	main[data-gap="lg"] {
		gap: var(--space-16);
	}

	@media (min-width: 48rem) {
		main {
			padding-block: var(--space-24);
		}

		/* The reading measure's generous padding is for long pages; a one-screen
		   composition sits closer to the nav and footer. */
		main[data-wide] {
			padding-block: var(--space-12);
		}
	}

	/* The screen measure gives way to the full page: the @page margins in
	   cv.astro are the only inset on paper. */
	@media print {
		main {
			max-width: none;
			padding: 0;
		}

		main[data-gap] {
			gap: var(--space-3);
		}
	}
</style>
