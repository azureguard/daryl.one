---
import { basics, work } from "@cv";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { formatDate, getPublishedPosts } from "@/lib/blog";

// The homepage is a router, not a destination: a status line, the identity
// block, one "Now" line, and destination cards. Everything is meant to be left.
const { name, label, summary, location } = basics;

const currentRole = work[0];
if (!currentRole) throw new Error("cv.json: expected at least one work entry");

const [latestPost] = await getPublishedPosts();

// Wayfinding labels, kept literal. The Blog card waits for a published post,
// like the nav link; Gallery is deferred, so Uses takes its slot.
const destinations = [
	{
		href: "/cv",
		eyebrow: "CV",
		title: "The résumé",
		description: "Experience, skills, and credentials: the whole record.",
	},
	...(latestPost
		? [
				{
					href: "/blog",
					eyebrow: "Blog",
					title: "Notes",
					description: "Notes on cloud security, detection engineering, and reviewable systems.",
				},
			]
		: []),
	{
		href: "/about",
		eyebrow: "About",
		title: "whoami",
		description: "The person behind the record, and how the route ran.",
	},
	{
		href: "/uses",
		eyebrow: "Uses",
		title: "The setup",
		description: "The hardware, software, and cloud tooling I use day to day.",
	},
];
---

<SiteLayout title={`${name} - ${label}`} gap="md">
	<div class="intro" data-reveal="scan">
		<p class="status label" data-reveal>
			<span class="signal" aria-hidden="true"></span>
			{location.city} · utc+8 · open to interesting problems
		</p>
		<h1>
			<span data-reveal="declassify" data-i="2">{name}</span>
		</h1>
		<p class="role" data-reveal data-i="4">{label}</p>
		<p class="summary" data-reveal data-i="5">{summary}</p>
		<div class="now" data-reveal data-i="6">
			<span class="label">Now</span>
			<p>{currentRole.position} at {currentRole.name}. {currentRole.summary}</p>
		</div>
	</div>

	<div class="cards" data-reveal data-i="7">
		{
			destinations.map((card) => (
				<a href={card.href} class="card" data-scope="card" data-part="root">
					<span class="label eyebrow">{card.eyebrow}</span>
					<h2>{card.title}</h2>
					<p>{card.description}</p>
				</a>
			))
		}
	</div>

	{
		latestPost && (
			<div class="latest">
				<p class="label">Latest post · {formatDate(latestPost.data.date)}</p>
				<a href={`/blog/${latestPost.id}`} class="label">
					{latestPost.data.title} →
				</a>
			</div>
		)
	}
</SiteLayout>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.status {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--text-muted);
	}

	.signal {
		width: 8px;
		height: 8px;
		background: var(--color-signal);
	}

	h1 {
		font-size: var(--text-display);
		text-transform: uppercase;
	}

	h1 span {
		display: inline-block;
	}

	.role {
		font-family: var(--font-display);
		font-weight: var(--weight-thin);
		font-size: var(--text-2xl);
		line-height: var(--leading-tight);
		text-transform: uppercase;
	}

	.summary {
		max-width: 62ch;
		font-size: var(--text-lg);
		color: var(--text-muted);
	}

	.now {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		max-width: 62ch;
		padding-left: var(--space-4);
		border-left: 4px solid var(--color-signal);
	}

	.now .label {
		color: var(--color-accent);
	}

	.now p {
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: var(--space-4);
	}

	.card .eyebrow {
		color: var(--color-accent);
	}

	.card h2 {
		font-size: var(--text-2xl);
		text-transform: uppercase;
	}

	.card p {
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.latest {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-6);
		padding-top: var(--space-6);
		border-top: 1px solid var(--border-default);
		color: var(--text-muted);
	}

	.latest a {
		text-decoration: none;
	}
</style>
