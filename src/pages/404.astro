---
import { basics } from "@cv";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPublishedPosts } from "@/lib/blog";

// Astro serves this file for any unmatched route under `output: "server"`, and
// the blog routes rewrite to it, so every 404 on the site looks the same.
// Astro does not set the status itself.
Astro.response.status = 404;

// The log block is shaped as `{ key, value }` rows so it lifts into a DS
// `LogBlock` later. `originPathname` survives a rewrite, where `Astro.url`
// would already read "/404"; Astro adds a trailing slash, which the row drops.
const entries = [
	{ key: "status", value: "404 NOT FOUND" },
	{ key: "resource", value: Astro.originPathname.replace(/(.)\/+$/, "$1") },
	{ key: "cause", value: "no route matches this address" },
	{ key: "action", value: "pick one of the links below" },
];
// Keys are padded so the values line up in the monospace block. The `<pre>`
// below is written tight: inside it, the template's own indentation would
// render as literal whitespace.
const keyWidth = Math.max(...entries.map(({ key }) => key.length));
const rows = entries.map(({ key, value }) => ({
	label: `${key}:`.padEnd(keyWidth + 1),
	value,
	tone: key === "status" ? "signal" : "body",
}));

const hasPosts = (await getPublishedPosts()).length > 0;
const links = [
	{ href: "/", label: "← Home" },
	{ href: "/cv", label: "CV" },
	...(hasPosts ? [{ href: "/blog", label: "Blog" }] : []),
];
---

<SiteLayout title={`Not found - ${basics.name}`} gap="sm">
	<pre class="log" data-reveal="scan"><code>{
			rows.map(({ label, value, tone }) => (
				<span class="row"><span>{label} </span><span data-tone={tone}>{value}</span></span>
			))
		}</code></pre>
	<h1><span data-reveal="declassify" data-i="2">Nothing on file.</span></h1>
	<p class="lede">
		There's no entry at this address. It may have been renamed, moved, or never existed. Check the URL, or pick up the
		trail from one of these instead.
	</p>
	<nav aria-label="Suggested pages">
		{
			links.map(({ href, label }) => (
				<a href={href} class="label">
					{label}
				</a>
			))
		}
	</nav>
</SiteLayout>

<style>
	.log {
		margin: 0;
		overflow-x: auto;
		padding: var(--space-4);
		background: var(--surface-card);
		box-shadow: inset 0 0 0 1px var(--border-default);
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
		color: var(--text-muted);
	}

	.row {
		display: block;
	}

	[data-tone="signal"] {
		color: var(--color-accent);
	}

	[data-tone="body"] {
		color: var(--text-body);
	}

	h1 {
		font-size: clamp(var(--text-3xl), 9vw, var(--text-4xl));
		text-transform: uppercase;
	}

	h1 span {
		display: inline-block;
	}

	.lede {
		max-width: 62ch;
		color: var(--text-muted);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
	}

	nav a {
		text-decoration: none;
	}
</style>
