---
import { basics } from "@cv";
import LogBlock from "@/components/LogBlock.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPublished } from "@/lib/content";

// The one page rendered on demand: every other route is a prerendered asset,
// so a request that matches none reaches the Worker, which renders this with
// the real status and the requested path. Astro does not set the status itself.
export const prerender = false;

Astro.response.status = 404;

// The request as a DS LogBlock. `originPathname` survives a rewrite, where
// `Astro.url` would already read "/404"; Astro adds a trailing slash, which the
// line drops. Keys are padded so the values line up in the mono column.
const entries = [
	{ key: "status", value: "404 NOT FOUND", tone: "highlight" as const },
	{ key: "resource", value: Astro.originPathname.replace(/(.)\/+$/, "$1") },
	{ key: "cause", value: "no route matches this address" },
	{ key: "action", value: "pick one of the links below" },
];
const keyWidth = Math.max(...entries.map(({ key }) => key.length));
const lines = entries.map(({ key, value, tone }) => ({ text: `${`${key}:`.padEnd(keyWidth + 1)} ${value}`, tone }));

const hasPosts = (await getPublished("blog")).length > 0;
const links = [
	{ href: "/", label: "← Home" },
	{ href: "/cv", label: "CV" },
	...(hasPosts ? [{ href: "/blog", label: "Blog" }] : []),
];
---

<SiteLayout title={`Not found - ${basics.name}`} description="There is no page at this address." gap="sm">
	<LogBlock title="request.log" lines={lines} data-reveal="scan" />
	<h1><span data-reveal="declassify" data-i="2">Nothing on file.</span></h1>
	<p class="lede">
		There's no entry at this address. It may have been renamed, moved, or never existed. Check the URL, or pick up the
		trail from one of these instead.
	</p>
	<nav aria-label="Suggested pages">
		{
			links.map(({ href, label }) => (
				<a href={href} class="label">
					{label}
				</a>
			))
		}
	</nav>
</SiteLayout>

<style>
	h1 {
		font-size: clamp(var(--text-3xl), 9vw, var(--text-4xl));
		text-transform: uppercase;
	}

	h1 span {
		display: inline-block;
	}

	.lede {
		max-width: 62ch;
		color: var(--text-muted);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
	}

	nav a {
		text-decoration: none;
	}
</style>
