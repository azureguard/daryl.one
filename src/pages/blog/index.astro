---
import { basics } from "@cv";
import PageHeader from "@/components/PageHeader.astro";
import PostTags from "@/components/PostTags.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { formatDate, getPublishedPosts, readTime } from "@/lib/blog";

// With nothing published, /blog is the site 404 rather than an empty log.
// SiteLayout and the homepage drop their links on the same condition.
const posts = await getPublishedPosts();
if (posts.length === 0) return Astro.rewrite("/404");
---

<SiteLayout title={`Blog - ${basics.name}`} gap="sm">
	<PageHeader eyebrow="Blog" title="Audit trail">
		<p>Notes on cloud security, detection engineering, and reviewable systems. A running log, newest first.</p>
	</PageHeader>

	<ol class="posts">
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}`}>
						<span class="meta label">
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							<span aria-hidden="true">·</span>
							<span>{readTime(post.body ?? "")}</span>
						</span>
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
					</a>
					<PostTags cvss={post.data.cvss} tags={post.data.tags} />
				</li>
			))
		}
	</ol>
</SiteLayout>

<style>
	.posts {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.posts > li {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-block: var(--space-8);
		border-bottom: 1px solid var(--border-default);
	}

	.posts > li:first-child {
		padding-top: 0;
	}

	.posts > li:last-child {
		border-bottom: 0;
	}

	a {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		color: var(--text-body);
		text-decoration: none;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		color: var(--text-muted);
	}

	h2 {
		font-size: var(--text-3xl);
		text-transform: uppercase;
		transition: color var(--motion-hover);
	}

	a:hover h2 {
		color: var(--color-accent);
	}

	a p {
		color: var(--text-muted);
	}
</style>
