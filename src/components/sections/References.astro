---
import { references } from "@cv";
import type { Reference } from "../../cv";
import { countMeta } from "../../meta";
import Section from "../Section.astro";

const items: Array<Reference> = references;
---

{
	items.length > 0 && (
		<Section title="References" eyebrow="Attestations" meta={countMeta(items.length)}>
			<ul class="references">
				{items.map(({ name, reference }) => (
					<li>
						<figure>
							<blockquote>{reference}</blockquote>
							<figcaption class="label">&mdash; {name}</figcaption>
						</figure>
					</li>
				))}
			</ul>
		</Section>
	)
}

<style>
	.references {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li + li {
		padding-top: var(--space-4);
		border-top: 1px solid var(--border-default);
	}

	blockquote {
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
		color: var(--text-muted);
	}

	figcaption {
		margin-top: var(--space-3);
		color: var(--text-muted);
	}

	@media print {
		.references {
			gap: var(--space-2);
		}

		li + li {
			padding-top: 0;
			border-top: 0;
		}
	}
</style>
