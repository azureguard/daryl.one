---
import { projects } from "@cv";
import { Icon } from "astro-icon/components";
import type { Project } from "../../cv";
import { countMeta } from "../../meta";
import Badge from "../Badge.astro";
import Section from "../Section.astro";

const items: Array<Project> = projects;
---

<Section title="Projects" eyebrow="Sandbox" meta={countMeta(items.length)} screenOnly>
	<div class="cards">
		{
			items.map(({ url, description, highlights, keywords, name }) => (
				<article class="card" data-scope="card" data-part="root">
					<h3>
						{url ? (
							<a href={url} title={`View ${name}`} target="_blank" rel="noopener noreferrer">
								{name}
								<Icon name="charm:link-external" aria-hidden="true" />
							</a>
						) : (
							name
						)}
					</h3>
					{description && <p class="description">{description}</p>}
					{highlights && highlights.length > 0 && (
						<ul class="highlights">
							{highlights.map((highlight) => (
								<li>{highlight}</li>
							))}
						</ul>
					)}
					{keywords && keywords.length > 0 && (
						<ul class="tags" aria-label="Keywords">
							{keywords.map((keyword) => (
								<li>
									<Badge>{keyword}</Badge>
								</li>
							))}
						</ul>
					)}
				</article>
			))
		}
	</div>
</Section>

<style>
	.cards {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.card {
		gap: var(--space-3);
	}

	.card:hover {
		box-shadow: inset 0 0 0 1px var(--border-raised);
	}

	h3 {
		font-size: var(--text-xl);
		text-transform: uppercase;
	}

	h3 a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--text-body);
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--color-accent);
	}

	h3 :global(svg) {
		width: 0.7em;
		height: 0.7em;
		color: var(--color-accent);
	}

	.description {
		font-size: var(--text-sm);
	}

	.highlights {
		margin: 0;
		padding-left: 1.1em;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.highlights li::marker {
		color: var(--color-accent);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: var(--space-1) 0 0;
		padding: 0;
		list-style: none;
	}
</style>
