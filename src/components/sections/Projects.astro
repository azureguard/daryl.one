---
import { projects } from "@cv";
import { Icon } from "astro-icon/components";
import type { Project } from "../../cv";
import Icons from "../../icons";
import Section from "../Section.astro";

const items: Array<Project> = projects;
---

<Section
	className={Astro.props.className}
	title="Projects"
	meta={`${items.length} record${items.length === 1 ? "" : "s"}`}
>
	<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
		{
			items.map(({ url, description, highlights, keywords, name }) => {
				return (
					<div class="grid-span-1 relative flex flex-col rounded-sm border border-skin-edge p-5">
						<div class="flex items-center gap-1.5">
							{url ? (
								<a
									class="group flex items-center gap-1.5 text-lg font-semibold tracking-tight decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline"
									href={url}
									title={`View ${name}`}
									target="_blank"
									rel="noopener noreferrer"
								>
									{name}
									<span class="text-skin-hue transition ease-linear group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none">
										<Icon aria-hidden="true" name={Icons.Link} />
									</span>
								</a>
							) : (
								<span class="text-lg font-semibold tracking-tight">{name}</span>
							)}
						</div>

						{description && (
							<p class="py-3 text-sm text-skin-base">{description}</p>
						)}
						{highlights && highlights.length > 0 && (
							<ul class="mt-1 ml-4 list-disc space-y-1 text-sm text-skin-muted">
								{highlights.map((highlight) => {
									return <li>{highlight}</li>;
								})}
							</ul>
						)}
						{keywords && keywords.length > 0 && (
							<ul class="mt-4 flex flex-wrap gap-2" aria-label="Keywords">
								{keywords.map((keyword) => (
									<li class="flex items-center rounded-sm border border-skin-edge px-2 py-0.5 font-mono text-xs text-skin-muted">
										{keyword}
									</li>
								))}
							</ul>
						)}
					</div>
				);
			})
		}
	</div>
</Section>
