---
import { languages } from "@cv";
import type { Language } from "../../cv";
import { countMeta } from "../../meta";
import Section from "../Section.astro";

const items: Array<Language> = languages;
---

{
	items.length > 0 && (
		<Section title="Languages" eyebrow="Fluency" meta={countMeta(items.length)}>
			<ul class="languages">
				{items.map(({ language, fluency }) => (
					<li>
						<span>{language}</span>
						<span class="fluency">{fluency}</span>
					</li>
				))}
			</ul>
		</Section>
	)
}

<style>
	.languages {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
	}

	/* The fluency is content ("Native speaker"), not a UI label, so it stays in
	   sentence case rather than the condensed-caps label treatment. */
	.fluency {
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	@media print {
		.languages {
			flex-direction: row;
			flex-wrap: wrap;
			gap: var(--space-1) var(--space-4);
		}

		li {
			font-size: var(--text-xs);
		}

		.fluency {
			font-size: var(--text-xs);
		}
	}
</style>
