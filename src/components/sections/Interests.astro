---
import { interests } from "@cv";
import type { Interest } from "../../cv";
import { countMeta } from "../../meta";
import Badge from "../Badge.astro";
import Section from "../Section.astro";

const items: Array<Interest> = interests;
---

{
	items.length > 0 && (
		<Section title="Interests" eyebrow="Out of scope" meta={countMeta(items.length)} screenOnly>
			<ul class="interests">
				{items.map(({ name, keywords }) => (
					<li>
						<h3 class="label">{name}</h3>
						{keywords && keywords.length > 0 && (
							<ul class="tags" aria-label={`${name} keywords`}>
								{keywords.map((keyword) => (
									<li>
										<Badge>{keyword}</Badge>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</Section>
	)
}

<style>
	.interests,
	.tags {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.interests {
		flex-direction: column;
		gap: var(--space-4);
	}

	h3 {
		margin-bottom: var(--space-2);
		font-size: var(--text-base);
	}

	.tags {
		flex-wrap: wrap;
		gap: var(--space-2);
	}
</style>
