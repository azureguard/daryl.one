---
import { Image } from "astro:assets";
import { basics } from "@cv";
import { Icon } from "astro-icon/components";
import avatar from "@/assets/avatar.jpg";
import Section from "@/components/Section.astro";
import Icons from "../../icons";

const { name, label, location, profiles, email } = basics;
const { city, region } = location;

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const stripProtocol = (value: string) => value.replace(/^https?:\/\//, "");
// The site URL is omitted: the email address already carries the domain.
const printContact = [email, linkedUrl && stripProtocol(linkedUrl)].filter(
	Boolean,
);
---

<Section>
	<div class="flex flex-col-reverse gap-8">
		<div class="info">
			<div class="flex flex-col gap-1 print:gap-0.5">
				<h1>{name}</h1>
				<h2>{label}</h2>
				<div
					class="flex items-center gap-2 pt-2 font-mono text-xs text-skin-muted print:hidden"
				>
					<Icon aria-hidden="true" name={Icons.Globe} />
					{city}, {region}
				</div>
			</div>
			<footer
				class="hidden font-mono text-xs text-skin-muted print:flex print:flex-col print:items-end print:gap-0.5 print:text-right"
			>
				{printContact.map((line) => <div>{line}</div>)}
				<div>
					{city}, {region}
				</div>
			</footer>
			<footer class="links">
				{
					email && (
						<div class="relative flex items-center">
							<span
								data-copy-toast
								role="status"
								class="pointer-events-none absolute -top-8 left-0 rounded-sm border border-skin-edge bg-skin-fill px-2 py-0.5 font-mono text-xs text-skin-hue opacity-0 transition-opacity duration-200 motion-reduce:transition-none"
							>
								copied
							</span>
							<button
								type="button"
								data-copy-email={email}
								aria-label={`Copy email address: ${email}`}
								class="group flex cursor-pointer items-center justify-center"
							>
								<svg
									data-copy-check
									class="hidden h-4 w-4 stroke-current"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M4.5 12.75l6 6 9-13.5"
									/>
								</svg>
								<span data-copy-idle>
									<Icon aria-hidden="true" name={Icons.Email} size="18" />
								</span>
							</button>
						</div>
					)
				}
				{
					profiles.map(({ network, url }) => {
						return (
							<a
								href={url}
								title={`Visit ${name} profile on ${network}`}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="sr-only">Visit {name} profile on {network}</span>
								{Icons[network] && (
									<Icon aria-hidden="true" name={Icons[network]} />
								)}
							</a>
						);
					})
				}
			</footer>
		</div>
		<figure class="relative w-fit print:hidden">
			<Image src={avatar} alt={name} loading="eager" />
			<div class="pointer-events-none absolute -inset-2">
				<div
					class="absolute -inset-y-8 right-0 w-px bg-skin-hue/50 mask-[linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
				<div
					class="absolute -inset-y-8 left-0 w-px bg-skin-hue/50 mask-[linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
				<div
					class="absolute -inset-x-8 bottom-0 h-px bg-skin-hue/50 mask-[linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
				<div
					class="absolute -inset-x-8 top-0 h-px bg-skin-hue/50 mask-[linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
			</div>
		</figure>
	</div>
</Section>

<style>
	@reference "../../styles/global.css";

	.info {
		@apply flex flex-col gap-1 pr-8 print:flex-row print:items-start print:justify-between print:gap-0 print:pr-0;
	}

	h1 {
		@apply text-4xl font-semibold tracking-tight print:text-2xl;
	}

	h2 {
		@apply text-base font-normal tracking-normal text-balance text-skin-muted print:text-base;
	}

	img {
		@apply aspect-square w-32 rounded-sm bg-cover;
	}

	/*
	 * Scoped narrowly to the copy-button's icon wrapper. These rules are
	 * unlayered, so a broad `span` selector would beat layered utilities —
	 * including the button's hover:text-skin-inverted — which is why the
	 * hover invert must live here alongside the base colour.
	 */
	.links button span {
		@apply flex items-center text-skin-hue;
	}

	/*
	 * The copy script toggles the `hidden` utility on this span; that utility
	 * is layered, so the unlayered flex above would override it and both icons
	 * would show. Re-assert the hide at equal (unlayered) footing.
	 */
	.links button span.hidden {
		display: none;
	}

	.links button:hover span {
		@apply text-skin-inverted;
	}

	/*
	 * Scoped to `.links` (not the `footer` element) so this unlayered rule
	 * can't fight the print-only contact footer's `hidden` utility. The
	 * print:hidden lives HERE (not in the markup) for the same reason:
	 * an unlayered `display: flex` would beat a layered utility.
	 */
	.links {
		@apply mt-2 flex gap-1 text-sm print:hidden;
	}

	.links a,
	.links button {
		@apply inline-flex size-8 items-center justify-center rounded-sm p-1 text-skin-hue transition-colors duration-200 hover:bg-skin-button-accent hover:text-skin-inverted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skin-hue motion-reduce:transition-none;
	}

	/* `screen and` keeps these unlayered rules from beating print:hidden when the print page is narrow. */
	@media screen and (width <= 700px) {
		.container {
			flex-direction: column-reverse;
		}

		.info {
			@apply pr-0 md:items-center md:justify-center;
		}

		figure {
			@apply flex md:items-center md:justify-center;
		}

		h2 {
			text-wrap: balance;
		}

		figure {
			@apply md:mx-auto;
		}
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
	const toast = document.querySelector<HTMLElement>("[data-copy-toast]");
	const check = button?.querySelector<SVGElement>("[data-copy-check]");
	const idle = button?.querySelector<HTMLElement>("[data-copy-idle]");
	let timer: ReturnType<typeof setTimeout> | undefined;

	const copyFallback = (text: string): boolean => {
		const textarea = document.createElement("textarea");
		textarea.value = text;
		textarea.setAttribute("readonly", "");
		textarea.style.position = "fixed";
		textarea.style.opacity = "0";
		document.body.appendChild(textarea);
		textarea.select();
		let copied = false;
		try {
			copied = document.execCommand("copy");
		} catch {
			copied = false;
		}
		textarea.remove();
		return copied;
	};

	button?.addEventListener("click", async () => {
		const email = button.dataset.copyEmail;
		if (!email) return;

		try {
			await navigator.clipboard.writeText(email);
		} catch {
			if (!copyFallback(email)) return;
		}

		check?.classList.remove("hidden");
		idle?.classList.add("hidden");
		toast?.classList.replace("opacity-0", "opacity-100");

		clearTimeout(timer);
		timer = setTimeout(() => {
			check?.classList.add("hidden");
			idle?.classList.remove("hidden");
			toast?.classList.replace("opacity-100", "opacity-0");
		}, 2000);
	});
</script>
