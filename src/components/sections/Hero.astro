---
import { basics } from "@cv";
import { Icon } from "astro-icon/components";
import CopyEmail from "@/components/CopyEmail.astro";
import Icons from "../../icons";

// No photo here, deliberately: a divergence from the DS resume template. The
// printed CV never had one, and the site's IA gives the portrait to /about.
// See plans/decisions-log.md.
//
// `label` renders as a <p>, not an <h2>: it is a tagline, not a section
// heading, and as a heading it pushed every real section down a level.
//
// The contact block is a row of links on screen and a right-aligned plain-text
// block on paper, so the printed header stays compact and parseable.
const { name, label, location, profiles, email } = basics;
const { city, region } = location;

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const stripProtocol = (value: string) => value.replace(/^https?:\/\//, "");
// The site URL is omitted: the email address already carries the domain.
const printContact = [email, linkedInfo?.url && stripProtocol(linkedInfo.url)].filter(Boolean);
---

<header class="hero">
	<div class="identity">
		<h1><span data-reveal="declassify">{name}</span></h1>
		<p class="tagline label" data-reveal data-i="2">{label}</p>
	</div>
	<div class="print-contact" data-print="only">
		{printContact.map((line) => <p>{line}</p>)}
		<p>{city}, {region}</p>
	</div>
	<div class="contact label" data-print="hidden" data-reveal data-i="3">
		<span class="item">
			<Icon name="charm:globe" aria-hidden="true" />
			{city}, {region}
		</span>
		{email && <CopyEmail email={email} />}
		{
			profiles.map(({ network, url, username }) => (
				<a href={url} title={`Visit ${name} profile on ${network}`} target="_blank" rel="noopener noreferrer" class="item">
					{Icons[network] && <Icon name={Icons[network]} aria-hidden="true" />}
					<span>{username}</span>
				</a>
			))
		}
	</div>
</header>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.identity {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	h1 {
		font-size: clamp(var(--text-3xl), 13vw, var(--text-5xl));
		text-transform: uppercase;
	}

	h1 span {
		display: inline-block;
	}

	.tagline {
		color: var(--color-accent);
		font-size: var(--text-base);
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-6);
		color: var(--text-muted);
	}

	.item {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	a.item {
		color: inherit;
		text-decoration: none;
	}

	a.item:hover {
		color: var(--color-accent);
	}

	.contact :global(svg) {
		width: 1.1em;
		height: 1.1em;
	}

	@media print {
		.hero {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
			gap: var(--space-4);
		}

		.identity {
			gap: var(--space-1);
		}

		h1 {
			font-size: var(--text-2xl);
			line-height: var(--leading-tight);
			text-transform: none;
		}

		.tagline {
			font-family: var(--font-sans);
			font-weight: var(--weight-body);
			font-size: var(--text-xs);
			letter-spacing: normal;
			text-transform: none;
			color: var(--text-muted);
		}

		.print-contact {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: 0.1rem;
			font-size: var(--text-xs);
			text-align: right;
			color: var(--text-muted);
		}
	}
</style>
