---
import { skills } from "@cv";
import { Icon } from "astro-icon/components";
import Icons from "../../icons";
import { countMeta } from "../../meta";
import Badge from "../Badge.astro";
import Section from "../Section.astro";

// Renders twice on /cv: the screen variant (icon + chips) and a print variant,
// a compact plain-text run. That run is the artifact an ATS parses: visible
// text, deliberately not hidden keyword-stuffing.
interface Props {
	variant?: "screen" | "print";
}

const { variant = "screen" } = Astro.props;
const meta = countMeta(skills.length);

const printSkills = skills
	.map(({ name, keywords = [] }) => (keywords.length > 0 ? `${name} (${keywords.join(", ")})` : name))
	.join(" · ");
---

{
	variant === "print" ? (
		<div data-print="only">
			<Section title="Skills" eyebrow="Toolbox" meta={meta}>
				<p class="run">{printSkills}</p>
			</Section>
		</div>
	) : (
		<Section title="Skills" eyebrow="Toolbox" meta={meta} screenOnly>
			<ul class="domains">
				{skills.map(({ name, keywords = [] }) => (
					<li>
						<h3 class="label">
							{name && Icons[name] && <Icon name={Icons[name]} aria-hidden="true" />}
							<span>{name}</span>
						</h3>
						{keywords.length > 0 && (
							<ul class="tags" aria-label={`${name} keywords`}>
								{keywords.map((keyword) => (
									<li>
										<Badge>{keyword}</Badge>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</Section>
	)
}

<style>
	.domains {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	h3 {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-3);
		font-size: var(--text-base);
	}

	h3 :global(svg) {
		width: 1.1em;
		height: 1.1em;
		color: var(--color-accent);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media print {
		.run {
			font-size: 10px;
			line-height: var(--leading-relaxed);
		}
	}
</style>
