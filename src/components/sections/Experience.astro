---
import { work } from "@cv";
import type { Work } from "../../cv";
import { rangeMeta } from "../../meta";
import Section from "../Section.astro";
import Timeline from "../Timeline.astro";

const jobs: Array<Work> = work;
---

<Section className={Astro.props.className} title="Experience" meta={rangeMeta(jobs)}>
	<Timeline entries={jobs} />
</Section>
