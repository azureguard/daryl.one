---
import { certificates, education } from "@cv";
import { Icon } from "astro-icon/components";
import Icons from "../../icons";
import Section from "../Section.astro";

const years = education
	.flatMap(({ startDate, endDate }) => [startDate, endDate])
	.map((date) => Number.parseInt(date ?? "", 10))
	.filter(Number.isFinite);
const recordCount = education.length + (certificates?.length ?? 0);
const meta = `${Math.min(...years)} — ${Math.max(...years)} · ${recordCount} record${recordCount === 1 ? "" : "s"}`;
---

<Section className={Astro.props.className} title="Education" meta={meta}>
	<ul class="space-y-4 py-3 print:space-y-0 print:py-1">
		{
			education.map(({ institution, startDate, endDate, area, url }) => {
				const startYear = new Date(startDate).getFullYear();
				const endYear =
					endDate != null ? new Date(endDate).getFullYear() : "Present";
				const years = `${startYear} - ${endYear}`;

				return (
					<li class="flex items-baseline gap-2">
						<Icon aria-hidden="true" name={Icons.Graduate} size="18" />
						<div class="relative w-full items-baseline justify-between gap-2">
							<h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium">
								<a
									target="_blank"
									rel="noopener noreferrer"
									class="group flex items-center gap-1.5 decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline"
									href={url}
								>
									{institution}
								</a>
							</h3>
							<div class="text-sm text-skin-muted">{area}</div>
							<time class="top-0 right-0 font-mono text-xs text-skin-muted md:absolute md:block">
								{years}
							</time>
						</div>
					</li>
				);
			})
		}
	</ul>

	{
		certificates && certificates.length > 0 && (
			<>
				<h4 class="mt-2 font-mono text-sm font-normal tracking-widest lowercase print:mt-1">
					Certificates
				</h4>
				<ul class="space-y-4 py-3 print:space-y-0 print:py-1">
					{certificates.map(({ name, date, issuer, url }) => {
						const certificateYear = new Date(date).getFullYear();
						return (
							<li class="flex items-baseline gap-1">
								<Icon aria-hidden="true" name={Icons.Certificate} size="18" />
								<div class="relative w-full items-baseline justify-between gap-2">
									<h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium">
										<a
											class="group flex items-center gap-1.5 text-skin-base decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline"
											href={url}
											target="_blank"
											rel="noopener noreferrer"
										>
											{name}
										</a>
									</h3>
									<div class="text-sm text-skin-muted">{issuer}</div>
									<time class="top-0 right-0 font-mono text-xs text-skin-muted md:absolute md:block">
										{certificateYear}
									</time>
								</div>
							</li>
						);
					})}
				</ul>
			</>
		)
	}
</Section>
