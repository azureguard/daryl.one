---
// Annotated log block, the DS's LogBlock (components/security/LogBlock.jsx),
// same props. Mono is for the log content only; the caption bar and margin
// notes are condensed caps. A line with a note gets a sodium gutter tick, and
// notes hang in their own right-hand column so they never collide with a long
// line. The DS writes tones as inline styles; the site writes no style
// attributes, so here they are `data-tone` attributes mapped below.
export interface LogLine {
	text: string;
	/** A leading "$ " shell prompt, excluded from selection. */
	prompt?: boolean | undefined;
	tone?: "highlight" | "danger" | "success" | "muted" | undefined;
	/** Right-hand margin annotation. */
	note?: string | undefined;
}

interface Props {
	/** Caption bar text, e.g. "auth.log". */
	title?: string | undefined;
	lines: Array<string | LogLine>;
	numbered?: boolean | undefined;
	/** Passed through to the figure, e.g. reveal attributes. */
	[attribute: `data-${string}`]: string | undefined;
}

const { title, lines, numbered = false, ...attributes } = Astro.props;
const rows = lines.map((line) => (typeof line === "string" ? { text: line } : line));
---

<figure class="log" data-numbered={numbered ? "" : undefined} {...attributes}>
	{title && <figcaption class="label">{title}</figcaption>}
	<div class="scroll">
		<div class="grid">
			{
				rows.map(({ text, prompt, tone, note }, index) => (
					<>
						{numbered && (
							<span class="number" aria-hidden="true" data-tone={tone} data-noted={note ? "" : undefined}>
								{index + 1}
							</span>
						)}
						<code data-tone={tone} data-noted={note ? "" : undefined}>
							{prompt && <span class="prompt">$ </span>}
							{text}
						</code>
						<span class="note label" data-tone={tone}>
							{note && `← ${note}`}
						</span>
					</>
				))
			}
		</div>
	</div>
</figure>

<style>
	.log {
		margin: 0;
		background: var(--surface-card);
		box-shadow: inset 0 0 0 1px var(--border-default);
	}

	figcaption {
		padding: var(--space-3) var(--space-4);
		background: var(--color-button-accent);
		color: var(--text-on-accent);
		line-height: 1;
	}

	.scroll {
		overflow-x: auto;
		padding-block: var(--space-3);
	}

	.grid {
		display: grid;
		grid-template-columns: max-content minmax(12ch, 1fr);
		min-width: min-content;
	}

	[data-numbered] .grid {
		grid-template-columns: auto max-content minmax(12ch, 1fr);
	}

	code,
	.number {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: 1.8;
	}

	code {
		padding: 0 var(--space-4);
		white-space: pre;
	}

	.number {
		padding: 0 var(--space-3) 0 var(--space-4);
		color: var(--text-muted);
		text-align: right;
		user-select: none;
	}

	[data-numbered] code {
		padding-left: 0;
	}

	/* The gutter tick sits on the first cell of an annotated line. */
	code[data-noted],
	.number[data-noted] {
		box-shadow: inset 3px 0 0 var(--color-signal);
	}

	[data-numbered] code[data-noted] {
		box-shadow: none;
	}

	.prompt {
		color: var(--color-accent);
		user-select: none;
	}

	.note {
		display: flex;
		align-items: center;
		padding: 0 var(--space-4);
		font-size: var(--text-xs);
		color: var(--color-accent);
		white-space: nowrap;
	}

	[data-tone="highlight"] {
		background: color-mix(in oklch, var(--color-signal) 16%, transparent);
	}

	[data-tone="danger"] {
		background: var(--severity-critical-surface);
		color: var(--severity-critical-text);
	}

	[data-tone="success"] {
		background: var(--severity-low-surface);
		color: var(--severity-low-text);
	}

	code[data-tone="muted"] {
		color: var(--text-muted);
	}

	/* A note keeps the accent on any tone's background. */
	.note[data-tone] {
		color: var(--color-accent);
	}
</style>
