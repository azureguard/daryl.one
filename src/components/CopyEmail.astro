---
import { Icon } from "astro-icon/components";

// Click-to-copy email control, shared by the CV hero and the site footer.
// Behaviour is Zag's clipboard machine (Ark UI's Clipboard): the server
// renders its anatomy, and the script below hands it to the machine.
//
// The toast is rendered EMPTY on purpose. `role="status"` implies
// aria-live="polite", but a live region only announces when its *content*
// changes, so the text is written in on copy and cleared on reset.
//
// The tick *replaces* the envelope, so the swap is width-neutral. Both are
// gated on `withIcon`: without an icon there is nothing to replace, and the
// toast is the whole feedback.
interface Props {
	email: string;
	/** Visible text. Defaults to the address itself (the Hero treatment). */
	label?: string | undefined;
	/** The Footer's link row is text-only, so it opts the icon out. */
	withIcon?: boolean | undefined;
}

const { email, label = email, withIcon = true } = Astro.props;
---

<span class="copy" data-copy-email={email} data-scope="clipboard" data-part="root">
	<span class="toast label" role="status" data-copy-toast></span>
	<button type="button" data-scope="clipboard" data-part="trigger" aria-label={`Copy email address: ${email}`}>
		{
			withIcon && (
				<span class="glyphs" aria-hidden="true">
					<span data-scope="clipboard" data-part="indicator" data-when="copied" hidden>
						<Icon name="lucide:check" />
					</span>
					<span data-scope="clipboard" data-part="indicator" data-when="idle">
						<Icon name="charm:mail" />
					</span>
				</span>
			)
		}
		<span>{label}</span>
	</button>
</span>

<style>
	.copy {
		position: relative;
		display: inline-flex;
		align-items: center;
	}

	button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		color: inherit;
		cursor: pointer;
		transition: color var(--motion-hover);
	}

	button:hover {
		color: var(--color-accent);
	}

	.glyphs {
		display: inline-flex;
	}

	.glyphs :global(svg) {
		width: 1.1em;
		height: 1.1em;
	}

	.toast {
		position: absolute;
		bottom: calc(100% + var(--space-2));
		left: 0;
		padding: var(--space-1) var(--space-2);
		background: var(--surface-raised);
		box-shadow: inset 0 0 0 1px var(--border-raised);
		color: var(--color-accent);
		font-size: var(--text-xs);
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transition: opacity var(--motion-panel);
	}

	[data-copied] .toast {
		opacity: 1;
	}
</style>

<script>
	import * as clipboard from "@zag-js/clipboard";
	import { VanillaMachine } from "@zag-js/vanilla";
	import { onEachPage, run } from "@/scripts/zag";

	let count = 0;

	onEachPage("[data-copy-email]", (root) => {
		const email = root.dataset.copyEmail ?? "";
		const machine = new VanillaMachine(clipboard.machine, {
			id: `copy-email-${count++}`,
			defaultValue: email,
			timeout: 2000,
			translations: {
				triggerLabel: (copied) => (copied ? "Email address copied" : `Copy email address: ${email}`),
			},
		});

		return run(machine, clipboard.connect, (api) => [
			[root, api.getRootProps()],
			[root.querySelector('[data-part="trigger"]'), api.getTriggerProps()],
			[root.querySelector('[data-when="copied"]'), api.getIndicatorProps({ copied: true })],
			[root.querySelector('[data-when="idle"]'), api.getIndicatorProps({ copied: false })],
			// Writing the text is what makes the live region announce.
			[root.querySelector("[data-copy-toast]"), { children: api.copied ? "copied" : "" }],
		]);
	});
</script>
