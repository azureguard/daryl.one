---
// Page-level header, one level up from Section's. The lede goes in the default
// slot. `data-reveal="declassify"` is the page's one orchestrated load moment.
//
// Over the h1 sits either the `eyebrow` prop, a decorative classifier and so
// aria-hidden, or an `eyebrow` slot for real content in that place (a post's
// date and read time), which stays readable. The `after` slot takes a row
// under the lede (a post's tags).
interface Props {
	eyebrow?: string | undefined;
	title: string;
}

const { eyebrow, title } = Astro.props;
---

<header>
	{
		Astro.slots.has("eyebrow") ? (
			<div class="label meta" data-reveal>
				<slot name="eyebrow" />
			</div>
		) : (
			eyebrow && (
				<p class="label eyebrow" aria-hidden="true" data-reveal>
					{eyebrow}
				</p>
			)
		)
	}
	<h1><span data-reveal="declassify" data-i="1">{title}</span></h1>
	<div class="lede" data-reveal data-i="3"><slot /></div>
	<slot name="after" />
</header>

<style>
	header {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-bottom: var(--space-8);
		border-bottom: 1px solid var(--border-default);
	}

	.eyebrow {
		color: var(--color-accent);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		color: var(--text-muted);
	}

	h1 {
		font-size: clamp(var(--text-3xl), 9vw, var(--text-4xl));
		text-transform: uppercase;
	}

	h1 span {
		display: inline-block;
	}

	.lede {
		max-width: 62ch;
		font-size: var(--text-lg);
		color: var(--text-muted);
	}

	.lede:empty {
		display: none;
	}
</style>
